page{background:#f7f8fa;color:#292637}.motor-page{padding:18px 16px calc(24px + env(safe-area-inset-bottom))}.eyebrow{font-size:10px;letter-spacing:3px;color:#a49aac}.title{font-size:25px;font-weight:700;margin:10px 0}.subtitle{font-size:12px;color:#908697;min-height:20px}.motor-grid{display:flex;flex-direction:column;gap:16px;margin-top:16px}.drive-card,.settings-card{background:#fff;border:1px solid #eeeaf3;border-radius:24px;padding:24px;box-sizing:border-box}.drive-card{text-align:center;background:#262935;color:#e7e2f6}.state-tag{display:inline-block;padding:6px 14px;background:#ffffff10;border-radius:20px;font-size:11px;color:#aaa6b8}.state-tag.active{color:#b2e8d6;background:#8ee0bd18}.rotor{width:130px;height:130px;border:1px solid #726786;border-radius:50%;margin:24px auto;position:relative}.rotor view{position:absolute;left:60px;top:10px;width:10px;height:46px;border-radius:10px;background:#9581d0;transform-origin:5px 55px}.rotor view:nth-child(2){transform:rotate(120deg)}.rotor view:nth-child(3){transform:rotate(240deg)}.rotor text{position:absolute;inset:49px 42px;background:#39344a;border-radius:50%;font-size:11px;line-height:32px}.spinning{animation:spin 4s linear infinite}@keyframes spin{to{transform:rotate(360deg)}}.direction-label{font-size:12px;color:#b2a7c3}.run-button{margin-top:20px;background:#8b70df;color:#fff;border-radius:14px;font-size:16px;line-height:48px}.run-button.stop{background:#4f425b}.connect{background:transparent;color:#c5b3e8;font-size:12px;margin-top:8px}.row{display:flex;align-items:center;justify-content:space-between;font-size:14px}.muted{font-size:10px;color:#a49aac;line-height:1.8}.direction-buttons{display:flex;gap:10px;margin:16px 0 28px}.direction-buttons button{flex:1;margin:0;background:#f5f2fa;color:#a397ae;border-radius:12px;font-size:13px;line-height:40px}.direction-buttons .selected{background:#eee8ff;color:#7659c7}.speed{font-size:30px;color:#7560dd;font-weight:600}.speed text{font-size:13px}slider{margin:16px 0}.keep-row{display:flex;align-items:center;justify-content:space-between;border-top:1px solid #f0edf4;padding-top:20px;margin-top:24px;font-size:14px}.policy{border-radius:12px;padding:12px;background:#f0edf8;color:#8d7a9e;font-size:11px;line-height:1.8;margin-top:12px}.warning{background:#fff5e8;color:#ad8148}.stop-always{background:#f9ecef;color:#b76678;border-radius:12px;font-size:13px;margin-top:16px}.error{color:#bc667b;font-size:12px;margin-top:12px}button::after{border:0}button[disabled]{opacity:.45}@media(orientation:landscape){.motor-grid{flex-direction:row;align-items:stretch}.drive-card{flex:1}.settings-card{flex:1.3}.motor-page{padding-left:calc(16px + env(safe-area-inset-left));padding-right:calc(16px + env(safe-area-inset-right))}}
.reversed{animation-direction:reverse}
