.page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 32rpx 30rpx 60rpx;
  background: #f7f8fa;
}

.status-card,
.remote-card {
  background: #ffffff;
  border-radius: 28rpx;
  border: 1rpx solid #eeedf3;
}

.status-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 112rpx;
  padding: 26rpx 28rpx;
  box-sizing: border-box;
}

.device-summary {
  display: flex;
  align-items: center;
  min-width: 0;
}

.device-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 76rpx;
  height: 76rpx;
  flex-shrink: 0;
  color: #ffffff;
  background: #7560dd;
  border-radius: 22rpx;
  font-size: 25rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
}

.device-copy {
  min-width: 0;
  margin-left: 22rpx;
}

.title {
  font-size: 34rpx;
  font-weight: 700;
  line-height: 1.2;
}

.status {
  display: flex;
  align-items: center;
  margin-top: 9rpx;
  color: #ef4444;
  font-size: 24rpx;
}

.status.online {
  color: #16a34a;
}

.status-dot {
  width: 12rpx;
  height: 12rpx;
  margin-right: 10rpx;
  background: currentColor;
  border-radius: 50%;
}

.connect-button {
  width: 166rpx;
  height: 72rpx;
  margin: 0;
  padding: 0;
  flex-shrink: 0;
  color: #ffffff;
  background: #262535;
  border-radius: 36rpx;
  font-size: 28rpx;
  font-weight: 600;
  line-height: 72rpx;
}

.connect-button.disconnect {
  color: #dc2626;
  background: #fef2f2;
}

.remote-card {
  margin-top: 30rpx;
  padding: 30rpx 28rpx 38rpx;
  box-sizing: border-box;
  overflow: hidden;
}

.remote-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 6rpx 24rpx;
}

.remote-title {
  color: #111827;
  font-size: 30rpx;
  font-weight: 700;
}

.remote-subtitle {
  margin-top: 6rpx;
  color: #94a3b8;
  font-size: 22rpx;
}

.remote-badge {
  padding: 8rpx 18rpx;
  color: #2563eb;
  background: #eff6ff;
  border-radius: 22rpx;
  font-size: 20rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
}

.direction-pad {
  width:380rpx;
  margin:28rpx auto 0;
  padding:12rpx;
  background: #f8fafc;
  border: 2rpx solid #eef2f7;
  border-radius: 190rpx;
  box-sizing: border-box;
}

.key-row {
  display: flex;
  width: 100%;
}

.key-row-center {
  justify-content: center;
}

.key-row-middle {
  justify-content: center;
  gap: 10rpx;
  margin: 10rpx 0;
}

.key {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 112rpx;
  min-width: 112rpx;
  max-width: 112rpx;
  height: 112rpx;
  margin: 0;
  padding: 0;
  flex: 0 0 112rpx;
  box-sizing: border-box;
  color: #777184;
  background: transparent;
  border-radius: 50%;
  line-height: 1;
}

.key-active {
  background: #2563eb;
  transform: scale(0.96);
  box-shadow: 0 5rpx 10rpx rgba(37, 99, 235, 0.22);
}

.key-symbol {
  font-size: 42rpx;
  font-weight: 500;
  line-height: 42rpx;
}

.key-label {
  margin-top: 12rpx;
  font-size: 22rpx;
  line-height: 24rpx;
}

.key-confirm {
  background: #7560dd;
  color:#fff;
  box-shadow: 0 8rpx 20rpx #7560dd25;
}

.confirm-dot {
  width: 28rpx;
  height: 28rpx;
  border: 6rpx solid rgba(255, 255, 255, 0.95);
  border-radius: 50%;
  box-sizing: border-box;
}

.hint {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 28rpx;
  color: #6b7280;
  font-size: 24rpx;
}

.hint-dot {
  width: 10rpx;
  height: 10rpx;
  margin-right: 12rpx;
  background: #94a3b8;
  border-radius: 50%;
}

.hint-dot.online {
  background: #22c55e;
}
.motor-entry{display:block;width:100%;padding:22rpx;color:#7860be;background:#eeebf8;border-radius:24rpx;text-align:center;box-sizing:border-box;font-size:24rpx}
