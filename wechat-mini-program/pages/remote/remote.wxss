.page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 32rpx 30rpx 60rpx;
  background: #f7f8fa;
}

.status-card,
.remote-card {
  background: #ffffff;
  border-radius: 28rpx;
  border: 1rpx solid #eeedf3;
}

.status-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 112rpx;
  padding: 26rpx 28rpx;
  box-sizing: border-box;
}

.device-summary {
  display: flex;
  align-items: center;
  min-width: 0;
}

.device-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 76rpx;
  height: 76rpx;
  flex-shrink: 0;
  color: #ffffff;
  background: #7560dd;
  border-radius: 22rpx;
  font-size: 25rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
}

.device-copy {
  min-width: 0;
  margin-left: 22rpx;
}

.title {
  font-size: 34rpx;
  font-weight: 700;
  line-height: 1.2;
}

.status {
  display: flex;
  align-items: center;
  margin-top: 9rpx;
  color: #ef4444;
  font-size: 24rpx;
}

.status.online {
  color: #16a34a;
}

.status-dot {
  width: 12rpx;
  height: 12rpx;
  margin-right: 10rpx;
  background: currentColor;
  border-radius: 50%;
}

.connect-button {
  width: 166rpx;
  height: 72rpx;
  margin: 0;
  padding: 0;
  flex-shrink: 0;
  color: #ffffff;
  background: #262535;
  border-radius: 36rpx;
  font-size: 28rpx;
  font-weight: 600;
  line-height: 72rpx;
}

.connect-button.disconnect {
  color: #dc2626;
  background: #fef2f2;
}

.remote-card {
  margin-top: 30rpx;
  padding: 30rpx 28rpx 38rpx;
  box-sizing: border-box;
  overflow: hidden;
}

.remote-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 6rpx 24rpx;
}

.remote-title {
  color: #111827;
  font-size: 30rpx;
  font-weight: 700;
}

.remote-subtitle {
  margin-top: 6rpx;
  color: #94a3b8;
  font-size: 22rpx;
}

.remote-badge {
  padding: 8rpx 18rpx;
  color: #2563eb;
  background: #eff6ff;
  border-radius: 22rpx;
  font-size: 20rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
}

.direction-pad {
  width:380rpx;
  margin:28rpx auto 0;
  padding:12rpx;
  background: #f8fafc;
  border: 2rpx solid #eef2f7;
  border-radius: 190rpx;
  box-sizing: border-box;
}

.key-row {
  display: flex;
  width: 100%;
}

.key-row-center {
  justify-content: center;
}

.key-row-middle {
  justify-content: center;
  gap: 10rpx;
  margin: 10rpx 0;
}

.key {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 112rpx;
  min-width: 112rpx;
  max-width: 112rpx;
  height: 112rpx;
  margin: 0;
  padding: 0;
  flex: 0 0 112rpx;
  box-sizing: border-box;
  color: #777184;
  background: transparent;
  border-radius: 50%;
  line-height: 1;
}

.key-active {
  background: #2563eb;
  transform: scale(0.96);
  box-shadow: 0 5rpx 10rpx rgba(37, 99, 235, 0.22);
}

.key-symbol {
  font-size: 42rpx;
  font-weight: 500;
  line-height: 42rpx;
}

.key-label {
  margin-top: 12rpx;
  font-size: 22rpx;
  line-height: 24rpx;
}

.key-confirm {
  background: #7560dd;
  color:#fff;
  box-shadow: 0 8rpx 20rpx #7560dd25;
}

.confirm-dot {
  width: 28rpx;
  height: 28rpx;
  border: 6rpx solid rgba(255, 255, 255, 0.95);
  border-radius: 50%;
  box-sizing: border-box;
}

.hint {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 28rpx;
  color: #6b7280;
  font-size: 24rpx;
}

.hint-dot {
  width: 10rpx;
  height: 10rpx;
  margin-right: 12rpx;
  background: #94a3b8;
  border-radius: 50%;
}

.hint-dot.online {
  background: #22c55e;
}
.motor-entry{display:block;width:100%;padding:22rpx;color:#7860be;background:#eeebf8;border-radius:24rpx;text-align:center;box-sizing:border-box;font-size:24rpx}
.brand-title{font-size:44rpx;letter-spacing:-1rpx;color:#7560dd;overflow-wrap:anywhere}
.feature-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:20rpx}
.feature-card{display:flex;flex-direction:column;justify-content:flex-end;min-height:260rpx}
.motor-card{background:#e5eef3;color:#425b6b}.motor-art{display:flex;align-items:center;justify-content:center}
.motor-ring{width:80rpx;height:80rpx;border:7rpx solid #839dad;border-radius:50%;box-sizing:border-box;box-shadow:inset 0 0 0 10rpx #d0dfe8}
.motor-axis{position:absolute;width:28rpx;height:7rpx;background:#839dad;border-radius:5rpx;left:calc(50% + 38rpx)}
.creator-card{background:#f3e9ed;color:#795866}.creator-art{display:flex;align-items:center;justify-content:center}
.mini-avatar-rim{width:94rpx;height:94rpx;padding:4rpx;box-sizing:border-box;border-radius:22rpx;background:linear-gradient(120deg,#ff729e,#ffca72,#6ae7c7,#74b8ff,#b48afa,#ff729e);background-size:300% 300%;animation:home-rainbow 8s ease-in-out infinite}
.mini-avatar{width:100%;height:100%;display:block;border-radius:18rpx}
@keyframes home-rainbow{0%,100%{background-position:0% 50%}50%{background-position:100% 50%}}
.home-features{display:block;width:100%}
@media(orientation:landscape){
 .page{height:100vh;min-height:0;overflow:hidden;display:flex;gap:16px;padding:10px calc(14px + env(safe-area-inset-right)) calc(10px + env(safe-area-inset-bottom)) calc(14px + env(safe-area-inset-left))}
 .home-control{flex:1;min-width:0;min-height:0;display:flex;flex-direction:column;height:100%}.page-heading{display:none}
 .status-card{flex-shrink:0;min-height:60px;padding:10px 12px;border-radius:16px;gap:8px}.device-icon{width:36px;height:36px;border-radius:12px;font-size:13px}.device-copy{margin-left:10px}.title{font-size:16px}.status{font-size:10px;margin-top:4px}.status-dot{width:5px;height:5px;margin-right:5px}.connect-button{width:72px;height:34px;line-height:34px;border-radius:18px;font-size:13px}
 .remote-card{flex:1;min-height:0;margin-top:10px;padding:10px;border-radius:18px;display:flex;flex-direction:column;justify-content:center}.remote-header{flex-shrink:0;padding:0 4px 6px}.remote-title{font-size:14px}.remote-subtitle{display:none}.remote-badge{font-size:10px;padding:4px 9px;border-radius:12px}
 .direction-pad{position:relative;width:min(190px,calc(100vh - 135px));height:min(190px,calc(100vh - 135px));min-width:100px;min-height:100px;padding:0;margin:0 auto;border-radius:50%;flex-shrink:0}
 .key-row{position:absolute;height:30%;width:100%;display:flex;justify-content:center}.key-row:first-child{top:0}.key-row:last-child{bottom:0}.key-row-middle{top:35%;margin:0;gap:5%;padding:0;justify-content:center}
 .key{width:30%;min-width:0;max-width:none;height:100%;flex:0 0 30%;border-radius:50%}.key-symbol{font-size:22px;line-height:24px}.key-label{display:none}.confirm-dot{width:18px;height:18px;border-width:3px}
 .home-features{flex:1.15;width:0;height:100%;min-height:0}.feature-grid{gap:12px;margin:0}.feature-card{min-height:135px;padding:16px;border-radius:20px}.feature-art{height:62px;margin-bottom:12px}.feature-title{font-size:15px;line-height:22px;white-space:nowrap}
 .orbit-art view{width:70px;height:23px;left:12px;top:2px;border-width:1px}.orbit-art view:nth-child(2){top:18px}.orbit-art view:nth-child(3){top:34px}.paint-art{font-size:60px;line-height:62px}.motor-ring{width:46px;height:46px;border-width:4px;box-shadow:inset 0 0 0 6px #d0dfe8}.motor-axis{width:16px;height:4px;left:calc(50% + 22px)}.mini-avatar-rim{width:54px;height:54px;padding:2px;border-radius:13px}.mini-avatar{border-radius:11px}.hint{font-size:10px;margin:14px 0}.hint-dot{width:5px;height:5px;margin-right:6px}
}
