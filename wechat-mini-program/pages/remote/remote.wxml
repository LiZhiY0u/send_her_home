<view class="page">
  <view class="page-heading"><text class="eyebrow">FIGURECASE</text><view class="hero-title">你的收藏，<text>自带光芒。</text></view><view class="hero-subtitle">为每一份热爱，调一束刚好的光</view></view>
  <view class="status-card">
    <view class="device-summary">
      <view class="device-icon">FC</view>
      <view class="device-copy">
        <view class="title">FigureCase</view>
        <view class="status {{connected ? 'online' : ''}}">
          <view class="status-dot"></view>
          <text>{{statusText}}</text>
        </view>
      </view>
    </view>
    <button
      class="connect-button {{connected ? 'disconnect' : ''}}"
      loading="{{connecting}}"
      disabled="{{connecting}}"
      bindtap="toggleConnection"
    >{{connected ? '断开' : '连接'}}</button>
  </view>

  <view class="remote-card">
    <view class="remote-header">
      <view>
        <view class="remote-title">设备遥控</view>
        <view class="remote-subtitle">轻触按键控制设备界面</view>
      </view>
      <view class="remote-badge">BLE</view>
    </view>

    <view class="direction-pad">
      <view class="key-row key-row-center">
        <view class="key" hover-class="key-active" hover-stay-time="80" data-code="1" bindtap="sendKey">
          <text class="key-symbol">↑</text>
          <text class="key-label">上</text>
        </view>
      </view>
      <view class="key-row key-row-middle">
        <view class="key" hover-class="key-active" hover-stay-time="80" data-code="3" bindtap="sendKey">
          <text class="key-symbol">←</text>
          <text class="key-label">左</text>
        </view>
        <view class="key key-confirm" hover-class="key-active" hover-stay-time="80" data-code="5" bindtap="sendKey">
          <text class="confirm-dot"></text>
          <text class="key-label">确定</text>
        </view>
        <view class="key" hover-class="key-active" hover-stay-time="80" data-code="4" bindtap="sendKey">
          <text class="key-symbol">→</text>
          <text class="key-label">右</text>
        </view>
      </view>
      <view class="key-row key-row-center">
        <view class="key" hover-class="key-active" hover-stay-time="80" data-code="2" bindtap="sendKey">
          <text class="key-symbol">↓</text>
          <text class="key-label">下</text>
        </view>
      </view>
    </view>
  </view>

  <view class="feature-grid">
    <navigator url="/pages/lighting/lighting" class="feature-card preview-card"><view class="feature-art orbit-art"><view></view><view></view><view></view></view><view class="feature-title">探索灯光 ↗</view><view class="feature-caption">3D 空间 · 离线预览</view></navigator>
    <navigator url="/pages/paint/paint" class="feature-card paint-card"><view class="feature-art paint-art">✦</view><view class="feature-title">以光作画 ↗</view><view class="feature-caption">软笔绘画 · 实时同步</view></navigator>
  </view>
  <view class="hint">
    <navigator url="/pages/motor/motor" class="motor-entry">电机控制 · 启停 / 方向 / 速度 ↗</navigator>
  </view>
  <view class="hint">
    <view class="hint-dot {{connected ? 'online' : ''}}"></view>
    <text>{{connected ? '连接正常，可以控制设备' : '开启手机蓝牙后连接设备'}}</text>
  </view>
</view>
