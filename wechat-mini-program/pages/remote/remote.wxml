<view class="page">
  <view class="home-control">
  <view class="page-heading"><text class="eyebrow">LIGHT / MOTION / CREATION</text><view class="hero-title brand-title">send_her_home</view></view>
  <view class="status-card">
    <view class="device-summary">
      <view class="device-icon">FC</view>
      <view class="device-copy">
        <view class="title">FigureCase</view>
        <view class="status {{connected ? 'online' : ''}}">
          <view class="status-dot"></view>
          <text>{{statusText}}</text>
        </view>
      </view>
    </view>
    <button
      class="connect-button {{connected ? 'disconnect' : ''}}"
      loading="{{connecting}}"
      disabled="{{connecting}}"
      bindtap="toggleConnection"
    >{{connected ? '断开' : '连接'}}</button>
  </view>

  <view class="remote-card">
    <view class="remote-header">
      <view>
        <view class="remote-title">设备遥控</view>
        <view class="remote-subtitle">轻触按键控制设备界面</view>
      </view>
      <view class="remote-badge">BLE</view>
    </view>

    <view class="direction-pad">
      <view class="key-row key-row-center">
        <view class="key" hover-class="key-active" hover-stay-time="80" data-code="1" bindtouchstart="startKey" bindtouchend="endKey" bindtouchcancel="endKey">
          <text class="key-symbol">↑</text>
          <text class="key-label">上</text>
        </view>
      </view>
      <view class="key-row key-row-middle">
        <view class="key" hover-class="key-active" hover-stay-time="80" data-code="3" bindtouchstart="startKey" bindtouchend="endKey" bindtouchcancel="endKey">
          <text class="key-symbol">←</text>
          <text class="key-label">左</text>
        </view>
        <view class="key key-confirm" hover-class="key-active" hover-stay-time="80" data-code="5" bindtap="sendKey">
          <text class="confirm-dot"></text>
          <text class="key-label">确定</text>
        </view>
        <view class="key" hover-class="key-active" hover-stay-time="80" data-code="4" bindtouchstart="startKey" bindtouchend="endKey" bindtouchcancel="endKey">
          <text class="key-symbol">→</text>
          <text class="key-label">右</text>
        </view>
      </view>
      <view class="key-row key-row-center">
        <view class="key" hover-class="key-active" hover-stay-time="80" data-code="2" bindtouchstart="startKey" bindtouchend="endKey" bindtouchcancel="endKey">
          <text class="key-symbol">↓</text>
          <text class="key-label">下</text>
        </view>
      </view>
    </view>
  </view>

  </view>
  <scroll-view class="home-features" scroll-y enhanced show-scrollbar="{{false}}">
  <view class="feature-grid">
    <navigator url="/pages/lighting/lighting" class="feature-card preview-card"><view class="feature-art orbit-art"><view></view><view></view><view></view></view><view class="feature-title">灯效 ↗</view></navigator>
    <navigator url="/pages/paint/paint" class="feature-card paint-card"><view class="feature-art paint-art">✦</view><view class="feature-title">画画 ↗</view></navigator>
    <navigator url="/pages/motor/motor" class="feature-card motor-card"><view class="feature-art motor-art"><view class="motor-ring"></view><view class="motor-axis"></view></view><view class="feature-title">转转 ↗</view></navigator>
    <navigator url="/pages/creator/creator" class="feature-card creator-card"><view class="feature-art creator-art"><view class="mini-avatar-rim"><image src="/assets/creator-avatar.jpg" mode="aspectFill" class="mini-avatar" /></view></view><view class="feature-title">😴 ↗</view></navigator>
  </view>
  <view class="hint">
    <view class="hint-dot {{connected ? 'online' : ''}}"></view>
    <text>{{connected ? '连接正常，可以控制设备' : '开启手机蓝牙后连接设备'}}</text>
  </view>
  </scroll-view>
</view>
