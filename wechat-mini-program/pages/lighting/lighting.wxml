<view class="lab">
  <view class="preview-pane">
  <view class="intro"><view class="heading">？！灯灯！？</view></view>
  <view class="stage">
    <canvas hidden="{{colorPickerVisible}}" type="webgl" id="light-scene" class="canvas" catchtouchstart="touchStart" catchtouchmove="touchMove" bindtouchend="touchEnd" bindtouchcancel="touchEnd" bindtap="tapScene"></canvas>
    <view class="error" wx:if="{{error}}"><text>{{error}}</text><navigator open-type="navigateBack" class="back-link">返回遥控器</navigator></view>
  </view>
  <view class="view-tools"><button size="mini" data-view="overall" bindtap="setView">整体</button><button size="mini" data-view="top" bindtap="setView">俯视</button><button size="mini" data-view="reset" bindtap="setView">复位</button><button size="mini" class="play" bindtap="togglePlayback">{{playing ? '暂停预览' : '播放预览'}}</button></view>
  </view>
  <scroll-view class="controls-scroll" scroll-y enhanced show-scrollbar="{{false}}">
  <view class="controls-content">
  <view class="device-control"><button loading="{{deviceBusy}}" disabled="{{deviceBusy}}" bindtap="applyDeviceEffect">应用到顶面和底面灯板</button><view>{{deviceStatus}}</view></view>
  <navigator url="/pages/paint/paint" class="paint-entry">在双面灯板上作画 ↗</navigator>
  <view class="panel">
    <view class="range-label"><text>随机颜色 · 渐变4秒</text><switch checked="{{randomColor}}" color="#8b70df" bindchange="toggleRandomColor" /></view>
    <view class="section-label">01 <text>选择灯层</text></view>
    <view class="choices"><button wx:for="{{layers}}" wx:key="value" class="chip {{layer === item.value ? 'active' : ''}}" data-field="layer" data-value="{{item.value}}" bindtap="choose">{{item.label}}</button></view>
    <view class="section-label">02 <text>选择区域</text></view>
    <view class="choices regions"><button wx:for="{{regions}}" wx:key="value" class="chip {{region === item.value ? 'active' : ''}}" data-field="region" data-value="{{item.value}}" bindtap="choose">{{item.label}}</button></view>
    <view class="section-label">03 <text>灯光效果</text></view>
    <view class="choices"><button wx:for="{{effects}}" wx:key="value" class="chip {{effect === item.value ? 'active' : ''}}" data-field="effect" data-value="{{item.value}}" bindtap="choose">{{item.label}}</button></view>
    <view class="color-row"><view wx:for="{{colors}}" wx:key="*this" aria-role="button" aria-label="颜色 {{item}}" class="swatch {{color === item ? 'chosen' : ''}}" style="background:{{item}}" data-field="color" data-value="{{item}}" bindtap="choose"></view></view>
    <button class="custom-color" bindtap="openColorPicker"><view class="custom-color-dot" style="background:{{color}}"></view><text>自定义颜色</text><text>{{color}}</text></button>
    <view class="range-label"><text>亮度</text><text>{{brightness}}%</text></view><slider min="0" max="100" value="{{brightness}}" activeColor="#8b70df" backgroundColor="#ece8f4" block-color="#8b70df" block-size="18" data-field="brightness" bindchanging="slider" bindchange="slider" />
    <view class="range-label"><text>速度</text><text>{{speed}}%</text></view><slider min="0" max="100" value="{{speed}}" activeColor="#8b70df" backgroundColor="#ece8f4" block-color="#8b70df" block-size="18" data-field="speed" bindchanging="slider" bindchange="slider" />
    <view class="linked"><text>上下联动</text><view class="choices"><button wx:for="{{linkModes}}" wx:key="value" class="chip {{linkedMode === item.value ? 'active' : ''}}" data-field="linkedMode" data-value="{{item.value}}" bindtap="choose">{{item.label}}</button></view></view>
  </view>
  </view>
  </scroll-view>
</view>
<color-picker visible="{{colorPickerVisible}}" color="{{color}}" bindpreview="previewPickerColor" bindconfirm="confirmPickerColor" bindcancel="cancelColorPicker" />
