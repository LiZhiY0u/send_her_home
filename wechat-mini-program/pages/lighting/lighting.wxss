page { background:#08121f; color:#e7f0f8; }
.lab { padding:32rpx 28rpx calc(40rpx + env(safe-area-inset-bottom)); }
.eyebrow { color:#75a5bb; font-size:20rpx; letter-spacing:4rpx; }
.heading { margin:14rpx 0 16rpx; font-size:39rpx; font-weight:600; }
.offline { color:#a9bac9; font-size:23rpx; display:flex; align-items:center; gap:12rpx; }
.dot { width:10rpx; height:10rpx; border-radius:50%; background:#57d9ff; }
.stage { margin-top:30rpx; border:1rpx solid #254153; border-radius:26rpx; overflow:hidden; background:#08121f; }
.stage-top,.stage-bottom { display:flex; justify-content:space-between; padding:22rpx 24rpx; color:#7b99ad; font-size:19rpx; letter-spacing:1rpx; }
.canvas { width:100%; height:660rpx; display:block; }
.error { padding:25rpx; color:#ffb0b8; font-size:25rpx; }
.back-link { margin-top:16rpx; color:#57d9ff; }
.view-tools { display:flex; gap:12rpx; margin:18rpx 0 28rpx; }
button { border-radius:14rpx; font-weight:400; }
button::after { border:0; }
.view-tools button { margin:0; padding:0 22rpx; color:#adc4d5; background:#142538; font-size:22rpx; line-height:64rpx; }
.view-tools .play { margin-left:auto; background:#184151; color:#90e9ff; }
.panel { background:#101f30; border:1rpx solid #20364a; border-radius:26rpx; padding:28rpx; }
.section-label { color:#57d9ff; font-size:21rpx; margin:0 0 18rpx; }
.section-label text { color:#d7e6f2; font-size:25rpx; margin-left:14rpx; }
.choices { display:flex; flex-wrap:wrap; gap:12rpx; margin-bottom:28rpx; }
.chip { background:#1a2b3e; color:#9db3c6; font-size:24rpx; padding:0 22rpx; line-height:68rpx; margin:0; }
.chip.active { background:#204858; color:#a0efff; box-shadow:inset 0 0 0 1rpx #4594aa; }
.regions .chip { font-size:22rpx; padding:0 22rpx; }
.color-row { display:flex; justify-content:space-between; padding:2rpx 6rpx 30rpx; }
.swatch { margin:0; padding:0; width:55rpx; height:55rpx; border-radius:50%; }
.swatch.chosen { outline:3rpx solid #e4f4ff; outline-offset:7rpx; }
.range-label { display:flex; justify-content:space-between; color:#b3c7d7; font-size:24rpx; }
slider { margin:22rpx 0 32rpx; }
.linked { display:flex; justify-content:space-between; align-items:center; color:#b3c7d7; font-size:24rpx; }
.linked .choices { margin:0; }
.notes { color:#688397; font-size:19rpx; line-height:1.9; text-align:center; margin-top:26rpx; }
