page { background:#f7f8fa; color:#282535; }
.lab { padding:32rpx 28rpx calc(40rpx + env(safe-area-inset-bottom)); }
.eyebrow { color:#a19aaa; font-size:19rpx; letter-spacing:4rpx; }
.heading { margin:14rpx 0 16rpx; font-size:39rpx; font-weight:600; }
.offline { color:#9993a4; font-size:23rpx; display:flex; align-items:center; gap:12rpx; }
.dot { width:10rpx; height:10rpx; border-radius:50%; background:#57d9ff; }
.stage { margin-top:30rpx; border:1rpx solid #20293b; border-radius:34rpx; overflow:hidden; background:#08121f; box-shadow:0 16rpx 32rpx #25253512; }
.stage-top,.stage-bottom { display:flex; justify-content:space-between; padding:22rpx 24rpx; color:#7b99ad; font-size:19rpx; letter-spacing:1rpx; }
.canvas { width:100%; height:660rpx; display:block; }
.error { padding:25rpx; color:#ffb0b8; font-size:25rpx; }
.back-link { margin-top:16rpx; color:#57d9ff; }
.view-tools { display:flex; gap:12rpx; margin:18rpx 0 28rpx; }
button { border-radius:14rpx; font-weight:400; }
button::after { border:0; }
.view-tools button { margin:0; padding:0 22rpx; color:#8a8098; background:#eeebf3; font-size:22rpx; line-height:64rpx; border-radius:22rpx; }
.view-tools .play { margin-left:auto; background:#7560dd; color:#fff; }
.panel { background:#fff; border:1rpx solid #eeedf3; border-radius:30rpx; padding:28rpx; }
.section-label { color:#b1a7bf; font-size:21rpx; margin:0 0 18rpx; }
.section-label text { color:#51465f; font-size:25rpx; margin-left:14rpx; }
.choices { display:flex; flex-wrap:wrap; gap:12rpx; margin-bottom:28rpx; }
.chip { background:#f5f3f8; color:#958a9f; font-size:24rpx; padding:0 22rpx; line-height:68rpx; margin:0; border-radius:22rpx; }
.chip.active { background:#eee8ff; color:#7659c7; }
.regions .chip { font-size:22rpx; padding:0 22rpx; }
.color-row { display:flex; justify-content:space-between; padding:2rpx 6rpx 30rpx; }
.swatch { margin:0; padding:0; width:55rpx; height:55rpx; border-radius:50%; }
.swatch.chosen { outline:3rpx solid #e4f4ff; outline-offset:7rpx; }
.range-label { display:flex; justify-content:space-between; color:#8a8098; font-size:24rpx; }
slider { margin:22rpx 0 32rpx; }
.linked { display:flex; flex-direction:column; align-items:flex-start; gap:18rpx; color:#8a8098; font-size:24rpx; }
.linked .choices { margin:0; }
.notes { color:#688397; font-size:19rpx; line-height:1.9; text-align:center; margin-top:26rpx; }
.paint-entry {padding:24rpx;text-align:center;color:#7860be;background:#eeebf8;border-radius:24rpx;margin-bottom:24rpx;font-size:25rpx}
.swatch.chosen {outline-color:#8b70df}
