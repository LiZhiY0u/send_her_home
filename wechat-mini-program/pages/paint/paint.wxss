page{background:#08121f;color:#e8f4fc}.page{padding:28rpx 28rpx calc(40rpx + env(safe-area-inset-bottom))}.eyebrow{font-size:20rpx;letter-spacing:3rpx;color:#6f9bb1}.title{font-size:42rpx;font-weight:600;margin:16rpx 0}.subtitle{font-size:23rpx;color:#8facbf}.status{font-size:24rpx;color:#83dfeb;padding:22rpx 0;min-height:36rpx}.board{border:1rpx solid #2c4759;border-radius:18rpx;overflow:hidden}.canvas{width:calc(100vw - 58rpx);height:calc(100vw - 58rpx);display:block}.tip{font-size:21rpx;color:#7794a8;text-align:center;line-height:1.8;margin:18rpx 0}.tools{display:flex;gap:16rpx;margin:24rpx 0}button{background:#192e41;color:#b5d1df;border-radius:14rpx;font-size:25rpx}.tools button{flex:1;margin:0}.tools .active{color:#6ae8fa}.colors{display:flex;justify-content:space-between;margin:34rpx 10rpx}.swatch{width:54rpx;height:54rpx;padding:0;border-radius:50%;margin:0}.chosen{outline:3rpx solid #fff;outline-offset:6rpx}.range{display:flex;justify-content:space-between;font-size:24rpx;color:#a4bdce}slider{margin:20rpx 0 28rpx}.sync{background:#23677c;color:#e2faff}.auto{margin-top:18rpx;background:#172838}
