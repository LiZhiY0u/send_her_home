<view class="page">
  <view class="drawing-pane">
  <view class="paint-heading">
  <view class="title">画画</view>
  <view class="status">{{status}}</view>
  </view>
  <view class="board"><canvas hidden="{{colorPickerVisible}}" type="2d" id="paint-board" class="canvas" catchtouchstart="touchStart" catchtouchmove="touchMove" bindtouchend="touchEnd" bindtouchcancel="touchEnd"></canvas><view wx:if="{{error}}">{{error}}</view></view>
  </view>
  <scroll-view class="paint-controls" scroll-y enhanced show-scrollbar="{{false}}">
  <view class="paint-controls-content">
  <view class="tools"><button class="{{eraser ? 'active' : ''}}" bindtap="toggleEraser">{{eraser ? '橡皮擦' : '画笔'}}</button><button bindtap="clearBoard">清空画布</button></view>
  <view class="colors"><view wx:for="{{colors}}" wx:key="*this" aria-role="button" aria-label="颜色 {{item}}" class="swatch {{color === item ? 'chosen' : ''}}" style="background:{{item}}" data-color="{{item}}" bindtap="chooseColor"></view></view>
  <button class="custom-color" bindtap="openColorPicker"><view class="custom-color-dot" style="background:{{color}}"></view><text>自定义颜色</text><text>{{color}}</text></button>
  <view class="range"><text>画笔直径</text><text>{{diameter}}mm</text></view>
  <slider min="10" max="60" step="2" value="{{diameter}}" activeColor="#8b70df" block-size="18" bindchanging="setWidth" bindchange="setWidth" />
  <button class="sync" loading="{{busy}}" disabled="{{busy}}" bindtap="synchronize">连接并同步绘画</button>
  <button class="auto" disabled="{{busy}}" bindtap="restoreAuto">恢复自动灯效</button>
  </view>
  </scroll-view>
</view>
<color-picker visible="{{colorPickerVisible}}" color="{{color}}" bindpreview="previewPickerColor" bindconfirm="confirmPickerColor" bindcancel="cancelColorPicker" />
