:host{display:block}.picker-mask{position:fixed;inset:0;z-index:9999;display:flex;align-items:center;justify-content:center;background:rgba(15,17,28,.58)}.picker-sheet{width:92vw;max-width:760px;height:90vh;max-height:800px;background:#faf9fd;border-radius:24px;box-sizing:border-box;overflow:hidden;display:flex;flex-direction:column;box-shadow:0 20px 60px #00000028}.picker-header{display:flex;align-items:center;gap:12px;padding:18px 20px;flex-shrink:0;font-size:17px;font-weight:600;color:#332c43}.color-sample{margin-left:auto;width:26px;height:26px;flex-shrink:0;border-radius:8px;border:1px solid #00000015}.color-code{font-size:12px;color:#8b7c9d;font-weight:400}.picker-workspace{display:flex;flex-direction:column;flex:1;min-height:0;gap:12px;padding:0 20px}.wheel-pane{display:flex;flex-direction:column;align-items:center;flex-shrink:0}.color-wheel{width:200px;height:200px;max-width:60vw;max-height:60vw;display:block}.picker-controls{flex:1;height:0;min-height:0;width:100%}.control-row{display:flex;align-items:center;justify-content:space-between;color:#8b7c9d;font-size:12px;padding:4px 0}slider{margin:8px 0 16px}.hex-row{display:flex;align-items:center;gap:16px;color:#82738e;font-size:13px;margin:6px 0}.hex-row input{min-width:0;flex:1;background:#eeebf6;border-radius:10px;padding:9px 12px;font-size:15px;color:#443451}.expand-rgb{margin:12px 0;padding:0 12px;border-radius:10px;background:#f1edf8;color:#8b78a1;font-size:12px;line-height:34px}.rgb-row{display:flex;gap:12px}.rgb-row>view{flex:1;min-width:0;color:#a194b0;font-size:11px}.rgb-row input{background:#eeebf6;border-radius:8px;padding:8px;margin-top:4px;color:#443451;font-size:14px}.input-error{color:#bd6e83;font-size:11px;padding:8px 0;line-height:1.6}.picker-footer{display:flex;gap:12px;padding:16px 20px calc(16px + env(safe-area-inset-bottom));flex-shrink:0}.picker-footer button{flex:1;min-width:0;margin:0;font-size:14px;line-height:42px;border-radius:12px}.cancel{background:#ede8f5;color:#8d7d9b}.confirm{background:#7960d5;color:#fff}.confirm[disabled]{opacity:.4}button::after{border:0}@media(orientation:landscape){.picker-sheet{height:92vh}.picker-workspace{flex-direction:row;gap:24px}.wheel-pane{width:min(48vh,240px);justify-content:center}.color-wheel{width:min(48vh,240px);height:min(48vh,240px);max-width:none;max-height:none}.picker-controls{height:100%;width:0}.picker-header{padding:12px 20px}.picker-footer{padding-top:10px;padding-bottom:calc(10px + env(safe-area-inset-bottom))}}
